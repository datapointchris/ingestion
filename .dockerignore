# The build reads the Go module, the release scripts that install yr, check
# out the scan's rules and download Docling's models, and the extractor
# programs' pinned Python libraries. What it never reads stays out of the context.
.git
.github
.task
deploy
release
!release/install-tools
!release/download-atr-rules
!release/download-docling-models
!release/python-requirements.txt
dist
ingestion
*.md
