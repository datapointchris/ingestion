#!/opt/ingestion/venv/bin/python3 -I
"""Transcribe the audio read on stdin with faster-whisper, and write what it heard as JSON lines.

The first line is the audio's info:

    {"language": "en", "language_probability": 0.98, "duration_ms": 312000, "voiced_ms": 290000}

language is what the model heard, and null where the voice-activity filter
kept no speech. Each later line is one segment of speech, in order:

    {"start_ms": 0, "duration_ms": 4200, "text": "..."}

The audio arrives in any container that ffmpeg reads. It is written to a file
in the run's directory first, because a container such as MP4 may keep its
index at its end, which a pipe cannot seek back to. ffmpeg decodes it to 16 kHz
mono, and the model reads it CHUNK_SECONDS at a time, so memory stays flat
however long the audio runs. A word that spans a chunk's end may split.

The model is large-v3-turbo at int8 on THREADS CPU threads, with beam 1 and
the voice-activity filter. It is read from MODEL, which the image fills at a
pinned revision, and never from the network. Audio that ffmpeg cannot decode
exits 1 naming why, and never quotes the audio.
"""

import os

# Set before huggingface_hub is imported, so no model is fetched at run time.
os.environ["HF_HUB_OFFLINE"] = "1"

import argparse
import json
import shutil
import subprocess
import sys
import tempfile

import numpy as np
from faster_whisper import WhisperModel

MODEL = "/usr/local/share/ingestion/whisper-models/large-v3-turbo"
FFMPEG = "/usr/local/bin/ffmpeg"
SAMPLE_RATE = 16000
# Ten minutes of 16 kHz float32 audio is 38 MB, beside the model's 1.6 GB.
CHUNK_SECONDS = 600
THREADS = 4


def fail(reason):
    print(f"audio-whisper: {reason}", file=sys.stderr)
    sys.exit(1)


def last_line(path):
    """The last line of the file at path, read from its last 4 KiB, or "" where it holds none."""
    with open(path, "rb") as f:
        f.seek(max(0, os.path.getsize(path) - 4096))
        lines = f.read().decode("utf-8", "replace").strip().splitlines()
    return lines[-1] if lines else ""


def chunks(path, ffmpeg, log):
    """Yield the audio at path as float32 16 kHz mono, CHUNK_SECONDS at a time.

    ffmpeg's stderr goes to the file at log rather than a pipe, because damaged
    audio can make ffmpeg log more than a pipe holds before its stdout ends.
    """
    with open(log, "wb") as errors:
        decoder = subprocess.Popen(
            [ffmpeg, "-nostdin", "-hide_banner", "-loglevel", "error", "-i", path,
             "-f", "s16le", "-ac", "1", "-ar", str(SAMPLE_RATE), "-"],
            stdout=subprocess.PIPE, stderr=errors,
        )
    size = CHUNK_SECONDS * SAMPLE_RATE * 2
    try:
        while True:
            raw = decoder.stdout.read(size)
            if not raw:
                break
            yield np.frombuffer(raw[: len(raw) - len(raw) % 2], dtype=np.int16).astype(np.float32) / 32768.0
    finally:
        decoder.stdout.close()
        if decoder.wait() != 0:
            fail("ffmpeg could not decode the audio: " + (last_line(log) or f"it exited {decoder.returncode}"))


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--model", default=MODEL, help="the model's directory (default %(default)s)")
    parser.add_argument("--ffmpeg", default=FFMPEG, help="the ffmpeg binary (default %(default)s)")
    parser.add_argument("--threads", type=int, default=THREADS, help="CPU threads (default %(default)s)")
    args = parser.parse_args()

    workdir = os.environ.get("TMPDIR") or tempfile.gettempdir()
    path = os.path.join(workdir, "audio")
    with open(path, "wb") as f:
        shutil.copyfileobj(sys.stdin.buffer, f, 1 << 20)
    if os.path.getsize(path) == 0:
        fail("stdin held no audio")

    model = WhisperModel(args.model, device="cpu", compute_type="int8", cpu_threads=args.threads, local_files_only=True)
    language, probability, decoded, voiced = None, 0.0, 0, 0.0
    segments = []
    for audio in chunks(path, args.ffmpeg, os.path.join(workdir, "ffmpeg.log")):
        offset_ms = decoded * 1000 // SAMPLE_RATE
        decoded += len(audio)
        found, info = model.transcribe(audio, language=language, beam_size=1, vad_filter=True)
        for s in found:
            text = " ".join(s.text.split())
            if text:
                start = offset_ms + round(s.start * 1000)
                segments.append({"start_ms": start, "duration_ms": max(0, offset_ms + round(s.end * 1000) - start), "text": text})
        voiced += info.duration_after_vad
        if language is None and info.duration_after_vad > 0:
            language, probability = info.language, info.language_probability
    os.remove(path)

    out = sys.stdout
    json.dump({"language": language, "language_probability": round(probability, 4),
               "duration_ms": decoded * 1000 // SAMPLE_RATE, "voiced_ms": round(voiced * 1000)}, out)
    out.write("\n")
    for s in segments:
        json.dump(s, out, ensure_ascii=False)
        out.write("\n")


if __name__ == "__main__":
    main()
