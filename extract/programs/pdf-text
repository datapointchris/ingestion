"""Write one JSON line per page of the PDF read on stdin: its printed label and its text.

A line is {"label": "xii", "text": "..."}. Every page writes a line, a blank
one included, so line n is PDF page n. The label is null where the PDF
declares no page labels. A PDF that cannot be opened, or that needs a
password, exits 1 naming why, and never quotes the document.
"""

import json
import sys

import pymupdf


def main() -> int:
    pymupdf.TOOLS.mupdf_display_errors(False)
    pymupdf.TOOLS.mupdf_display_warnings(False)
    data = sys.stdin.buffer.read()
    try:
        doc = pymupdf.open(stream=data, filetype="pdf")
    except Exception as error:  # PyMuPDF raises several types for a broken file.
        print(f"pdf-text: PyMuPDF could not open the bytes as a PDF ({type(error).__name__})", file=sys.stderr)
        return 1
    if doc.needs_pass:
        print("pdf-text: the PDF needs a password", file=sys.stderr)
        return 1
    labeled = bool(doc.get_page_labels())
    out = sys.stdout
    for page in doc:
        label = page.get_label() if labeled else ""
        out.write(json.dumps({"label": label or None, "text": page.get_text("text")}, ensure_ascii=False))
        out.write("\n")
    out.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
