#!/usr/bin/env bash
# Installs each tool the release, the image build and the scan's tests call, at
# a pinned version and SHA-256.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: install-tools <directory> <tool>...

Downloads each tool's linux/amd64 release into <directory>, checks it against
the SHA-256 pinned here, and leaves an executable named for the tool. Where
the release carries its license, it leaves that beside the tool as
<tool>-LICENSE.txt. The tools are the names that pin below takes.

A bump edits a tool's version and its SHA-256 together.
EOF
}

die() {
  printf 'install-tools: %s\n' "$*" >&2
  exit 1
}

if [ $# -lt 2 ]; then
  usage >&2
  exit 2
fi
directory=$1
shift

# Sets version, sha256, url, member: the file to take from a tarball, or empty
# where the asset is the binary itself, and license: the tarball's license
# file, or empty where none ships.
pin() {
  license=
  case $1 in
    kustomize)
      version=5.8.3
      sha256=cb9e31198d3f63b44848bd0afc4c8efc56e6cfef9c93a4a39a211940e6decd61
      url=https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2Fv$version/kustomize_v${version}_linux_amd64.tar.gz
      member=kustomize
      ;;
    flux)
      version=2.9.6
      sha256=b4d22673e9246cbd628881f1a9ef3b090085dced291e42d804555cee8e8d42c5
      url=https://github.com/fluxcd/flux2/releases/download/v$version/flux_${version}_linux_amd64.tar.gz
      member=flux
      ;;
    cosign)
      version=3.1.4
      sha256=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
      url=https://github.com/sigstore/cosign/releases/download/v$version/cosign-linux-amd64
      member=
      ;;
    # YARA-X's CLI, which the scan stage runs. The worker image carries it.
    yr)
      version=1.24.0
      sha256=b98628160a5dcbb6afcbba6886b0f4a275df930923ae3bb3553d83115744fb29
      url=https://github.com/VirusTotal/yara-x/releases/download/v$version/yara-x-v$version-x86_64-unknown-linux-gnu.tar.gz
      member=yr
      ;;
    # A static FFmpeg built with only LGPL parts, which audio-whisper runs to
    # decode a video's audio. The worker image carries it. The build is one
    # that FFmpeg-Builds keeps as its month's last.
    ffmpeg)
      version=n8.1.3-27-g8dca1586f4
      sha256=a64f3171e6ad1f7d358d28890a907ee478c331d1177ec696a93418f79ac3f1f3
      url=https://github.com/FFmpeg-Builds/FFmpeg-Builds/releases/download/autobuild-2026-10-31-12-59/ffmpeg-$version-linux64-lgpl-8.1.tar.xz
      member=ffmpeg-$version-linux64-lgpl-8.1/bin/ffmpeg
      license=ffmpeg-$version-linux64-lgpl-8.1/LICENSE.txt
      ;;
    *) die "no pin for $1" ;;
  esac
}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$directory"
for tool in "$@"; do
  pin "$tool"
  asset=$work/$tool.download
  curl -fsSL --retry 3 -o "$asset" "$url"
  printf '%s  %s\n' "$sha256" "$asset" | sha256sum -c --quiet - \
    || die "$tool $version does not match its pinned SHA-256"
  if [ -n "$member" ]; then
    tar -xf "$asset" -C "$work" "$member" ${license:+"$license"}
    install -m 0755 "$work/$member" "$directory/$tool"
    if [ -n "$license" ]; then
      install -m 0644 "$work/$license" "$directory/$tool-LICENSE.txt"
    fi
  else
    install -m 0755 "$asset" "$directory/$tool"
  fi
  echo "installed $tool $version"
done
