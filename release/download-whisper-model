#!/usr/bin/env bash
# Downloads the model files that audio-whisper reads, each at a pinned commit
# of its Hugging Face repository and checked against its pinned SHA-256.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: download-whisper-model <directory>

Writes each file to <directory>/large-v3-turbo/<path>, the directory that
audio-whisper's MODEL names, so faster-whisper loads the model there and never
reaches the network.

A bump moves the commit and the SHA-256 of each file together.
extract.WhisperPins then takes the digest that its test prints, so a
transcript by the new weights writes beside the old one.
EOF
}

die() {
  printf 'download-whisper-model: %s\n' "$*" >&2
  exit 1
}

if [ $# -ne 1 ]; then
  usage >&2
  exit 2
fi
directory=$1

# Each line is a repository, its commit, a file's path in it and the file's
# SHA-256. The repository is a CTranslate2 conversion of Whisper
# large-v3-turbo, and Whisper's weights are MIT licensed. It is the one that
# faster-whisper's own name for the model,
# mobiuslabsgmbh/faster-whisper-large-v3-turbo, redirected to when these pins
# were taken.
pins='
dropbox-dash/faster-whisper-large-v3-turbo 0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf config.json b0253ea6c0d3bea6b1e19e91a02acfd3b53f4467362efcb5a3e6b16c9b3a9b7e
dropbox-dash/faster-whisper-large-v3-turbo 0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf preprocessor_config.json 7ccc62c6f2765af1f3b46c00c9b5894426835a05021c8b9c01eecb6dfb542711
dropbox-dash/faster-whisper-large-v3-turbo 0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf tokenizer.json 297b13372ac43916285644fb9687add3cc62ee2a1adb60da3dc25cc94c1871fd
dropbox-dash/faster-whisper-large-v3-turbo 0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf vocabulary.json c69260f2ab26d659b7c398f9a2b2b48ed0df16c3b47d7326782fd9cba71690c1
dropbox-dash/faster-whisper-large-v3-turbo 0a363e9161cbc7ed1431c9597a8ceaf0c4f78fcf model.bin e76620f83d5f5b69efd3d87e3dc180c1bd21df9fbebacfd4335e5e1efcc018da
'

while read -r repository commit path sha256; do
  [ -n "$repository" ] || continue
  target=$directory/large-v3-turbo/$path
  mkdir -p "$(dirname "$target")"
  curl -fsSL --retry 3 -o "$target" "https://huggingface.co/$repository/resolve/$commit/$path"
  printf '%s  %s\n' "$sha256" "$target" | sha256sum -c --quiet - \
    || die "$repository's $path at $commit does not match its pinned SHA-256"
  echo "downloaded $repository $path"
done <<<"$pins"
