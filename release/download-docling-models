#!/usr/bin/env bash
# Downloads the model files that pdf-docling reads, each at a pinned commit of
# its Hugging Face repository and checked against its pinned SHA-256.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: download-docling-models <directory>

Writes each file to <directory>/<owner>--<repository>/<path>, the layout that
Docling's artifacts_path reads, so pdf-docling finds every model there and
never reaches the network.

A bump moves a repository's commit and the SHA-256 of each of its files
together. extract.DoclingPins then takes the digest that its test prints, so a
parse by the new weights writes beside the old one.
EOF
}

die() {
  printf 'download-docling-models: %s\n' "$*" >&2
  exit 1
}

if [ $# -ne 1 ]; then
  usage >&2
  exit 2
fi
directory=$1

# Each line is a repository, its commit, a file's path in it and the file's
# SHA-256. The layout model is Apache-2.0, and TableFormer is
# CDLA-Permissive-2.0. The table stage reads TableFormer's accurate model, so
# the fast one stays out.
pins='
docling-project/docling-layout-heron 8f39ad3c0b4c58e9c2d2c84a38465abf757272d8 config.json fdea30805ce2f5666b147fca941dcdd27ad468e27d6ed21902207d3da056a97d
docling-project/docling-layout-heron 8f39ad3c0b4c58e9c2d2c84a38465abf757272d8 preprocessor_config.json cd38cd59999e7a95d68e487fbe5132df3d4e5c32a0836add57e6126ba0c4eaf1
docling-project/docling-layout-heron 8f39ad3c0b4c58e9c2d2c84a38465abf757272d8 model.safetensors 00333a43451945aaf89db8ca9c0a17e75d1537c17db60fdb91aa95f4c7929e0c
docling-project/docling-models fc0f2d45e2218ea24bce5045f58a389aed16dc23 model_artifacts/tableformer/accurate/tm_config.json 984e122ceb8ccf84d84c9d2882f6f2302a44b4f1e577babd6289892c36f3cffd
docling-project/docling-models fc0f2d45e2218ea24bce5045f58a389aed16dc23 model_artifacts/tableformer/accurate/tableformer_accurate.safetensors 2a7d6c924b3cd12fb99a09280ca9c33a89c5d60b93253617d2e088c1a40374d9
'

while read -r repository commit path sha256; do
  [ -n "$repository" ] || continue
  target=$directory/${repository/\//--}/$path
  mkdir -p "$(dirname "$target")"
  curl -fsSL --retry 3 -o "$target" "https://huggingface.co/$repository/resolve/$commit/$path"
  printf '%s  %s\n' "$sha256" "$target" | sha256sum -c --quiet - \
    || die "$repository's $path at $commit does not match its pinned SHA-256"
  echo "downloaded $repository $path"
done <<<"$pins"
