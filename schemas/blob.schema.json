{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/datapointchris/ingestion/schemas/blob.schema.json",
  "title": "One blob row",
  "description": "What PUT /api/v1/blobs/{sha256} answers, with 201 where the row is new and 200 where it was held, and one entry of the unpaired report's missing rows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sha256", "md5", "size_bytes", "media_type", "created_ts"],
  "properties": {
    "schema_version": {"const": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "md5": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "media_type": {"type": "string"},
    "created_ts": {"type": "string", "format": "date-time"}
  }
}
