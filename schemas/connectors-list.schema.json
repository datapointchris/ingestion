{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/datapointchris/ingestion/schemas/connectors-list.schema.json",
  "title": "Each connector's freshness",
  "description": "What GET /api/v1/connectors answers and `ingestion connectors list --json` prints: each applied connector, its last delivery, its items by stage and when the scheduler next makes it due. GET /api/v1/connectors/{name} answers one of these with its first fill.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "connectors"],
  "properties": {
    "schema_version": {"const": 1},
    "connectors": {"type": "array", "items": {"$ref": "#/$defs/connector"}}
  },
  "$defs": {
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uncached_input", "cache_write", "cache_read", "output"],
      "properties": {
        "uncached_input": {"type": "integer"},
        "cache_write": {"type": "integer"},
        "cache_read": {"type": "integer"},
        "output": {"type": "integer"}
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mode", "zone", "applied_commit", "items", "waiting", "review", "failed", "due_at", "overdue"],
      "properties": {
        "name": {"type": "string"},
        "mode": {"enum": ["poll", "push", "folder", "drop"]},
        "zone": {"description": "The connector's default zone for what it carries.", "enum": ["outside", "owner"]},
        "applied_commit": {"type": "string"},
        "last_delivery_ts": {"type": ["string", "null"], "format": "date-time"},
        "items": {"description": "Every item the connector sighted.", "type": "integer"},
        "waiting": {"description": "Items held at a model stage.", "type": "integer"},
        "review": {"description": "Items waiting on a person's placement.", "type": "integer"},
        "failed": {"description": "Items whose latest task failed.", "type": "integer"},
        "schedule": {"description": "A poll's schedule.", "type": ["string", "null"]},
        "due_interval": {"description": "How often a drop or push is expected.", "type": ["string", "null"]},
        "due_at": {"description": "When the scheduler next makes the connector due.", "type": "string", "format": "date-time"},
        "overdue": {"description": "True once due_at has passed with no delivery since.", "type": "boolean"},
        "first_fill": {
          "description": "Answered on one connector alone.",
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {"enum": ["held", "released", "none"]},
            "item_key": {"description": "The one item the held fill ran end to end.", "type": ["string", "null"]},
            "held": {"description": "Items held behind it.", "type": "integer"},
            "tokens": {
              "description": "That item's tokens, by model stage.",
              "type": "object",
              "additionalProperties": {"$ref": "#/$defs/tokens"}
            }
          }
        }
      }
    }
  }
}
