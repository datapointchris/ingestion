{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/datapointchris/ingestion/schemas/item-parse.schema.json",
  "title": "One item's newest parse, with the scanner's findings",
  "description": "What GET /api/v1/items/{key}/parse answers. `ingestion push` hands the same document to its destination, so the findings travel with the text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key", "zone", "media_type", "extractor", "extractor_version", "text", "units", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "key": {"type": "string"},
    "zone": {"enum": ["outside", "owner"]},
    "title": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"]},
    "media_type": {"type": "string"},
    "extractor": {"type": "string"},
    "extractor_version": {"type": "string"},
    "text": {"type": "string"},
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "text"],
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "label": {"type": ["string", "null"]},
          "text": {"type": "string"}
        }
      }
    },
    "rules_version": {"description": "The scanner's rules version the findings came from.", "type": ["string", "null"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "severity", "span"],
        "properties": {
          "rule": {"type": "string"},
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "unit": {"type": ["integer", "null"]},
          "span": {"type": "string"}
        }
      }
    }
  }
}
