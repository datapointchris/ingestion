{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/datapointchris/ingestion/schemas/item-parse.schema.json",
  "title": "One item's newest parse, with the scanner's findings",
  "description": "What GET /api/v1/items/{key}/parse answers. `ingestion push` writes psyche's parse-input document from this answer, so the findings travel with the text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key", "zone", "media_type", "extractor", "extractor_version", "text", "units", "findings"],
  "properties": {
    "schema_version": {"const": 1},
    "key": {"type": "string"},
    "zone": {"enum": ["outside", "owner"]},
    "title": {"type": ["string", "null"]},
    "url": {"type": ["string", "null"]},
    "media_type": {"type": "string"},
    "extractor": {"type": "string"},
    "extractor_version": {"type": "string"},
    "text": {"type": "string"},
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "text"],
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "label": {"type": ["string", "null"]},
          "text": {"type": "string"}
        }
      }
    },
    "rules_version": {"description": "The rules version of the newest scan that read this parse, and null where no scan read it. Each finding's unit is a place in this parse's units.", "type": ["string", "null"]},
    "findings": {
      "type": "array",
      "items": {
        "$ref": "ingestion-record.schema.json#/$defs/finding",
        "required": ["span"],
        "properties": {"span": {"description": "The matched text, at most its first 1024 bytes.", "type": "string"}},
        "unevaluatedProperties": false
      }
    }
  }
}
