{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/datapointchris/ingestion/schemas/item.schema.json",
  "title": "One item and every record it holds",
  "description": "What GET /api/v1/items/{key} answers and `ingestion items show --json` prints: the item, each home its file lives at, each sighting, each stage's output, each gate decision, each delivery and its latest suggestion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "item", "homes", "sightings", "outputs", "decisions", "deliveries"],
  "properties": {
    "schema_version": {"const": 1},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "zone", "media_type", "flow_id", "phase", "created_ts"],
      "properties": {
        "key": {"type": "string"},
        "zone": {"enum": ["outside", "owner"]},
        "media_type": {"type": "string"},
        "title": {"type": ["string", "null"]},
        "url": {"type": ["string", "null"]},
        "blob_sha256": {"type": ["string", "null"]},
        "size_bytes": {"type": ["integer", "null"]},
        "md5": {"description": "The bytes' MD5, which a reader such as sioyek keys a book's annotations by.", "type": ["string", "null"]},
        "parent_key": {"type": ["string", "null"]},
        "flow_id": {"type": "string"},
        "phase": {"$ref": "items-list.schema.json#/$defs/phase"},
        "waiting_at": {"$ref": "items-list.schema.json#/$defs/waiting_at"},
        "created_ts": {"type": "string", "format": "date-time"}
      }
    },
    "homes": {
      "description": "Each place the item's file lives under a named root, where it was referenced rather than copied. A home gone from its root keeps its row.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root", "path", "found_ts"],
        "properties": {
          "root": {"type": "string"},
          "path": {"description": "The file's place below its root, with forward slashes.", "type": "string"},
          "modified_ts": {"description": "The file's modification time, to the nanosecond, when its bytes were last hashed at this path.", "type": ["string", "null"], "format": "date-time"},
          "found_ts": {"type": "string", "format": "date-time"},
          "gone_ts": {"type": ["string", "null"], "format": "date-time"}
        }
      }
    },
    "sightings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connector", "external_key", "tags", "zone", "first_seen_ts", "last_seen_ts"],
        "properties": {
          "connector": {"type": "string"},
          "external_key": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "fields": {"description": "Values the connector read from the source's payload, by name, such as a Reddit save's subreddit. A routing rule matches them. Outsider text where the zone is outside.", "type": "object", "additionalProperties": {"type": "string"}},
          "zone": {"enum": ["outside", "owner"]},
          "cursor_position": {"description": "The connector's cursor where it last delivered the item.", "type": ["string", "null"]},
          "first_seen_ts": {"type": "string", "format": "date-time"},
          "last_seen_ts": {"type": "string", "format": "date-time"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "producer", "producer_version", "state"],
        "properties": {
          "stage": {"enum": ["parse", "scan", "quality", "model-read"]},
          "producer": {"type": "string"},
          "producer_version": {"type": "string"},
          "lens": {"type": ["string", "null"]},
          "lens_version": {"type": ["string", "null"]},
          "state": {"enum": ["waiting", "done", "failed"]},
          "units": {"description": "A parse's unit count.", "type": ["integer", "null"]},
          "findings": {
            "type": ["array", "null"],
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["rule", "severity"],
              "properties": {
                "rule": {"type": "string"},
                "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
                "span": {"type": ["string", "null"]}
              }
            }
          },
          "answer": {"description": "A model stage's structured answer.", "type": ["object", "null"]},
          "run_id": {"type": ["string", "null"]},
          "tokens": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "uncached_input": {"type": "integer"},
              "cache_write": {"type": "integer"},
              "cache_read": {"type": "integer"},
              "output": {"type": "integer"}
            }
          },
          "error": {"type": ["string", "null"]}
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "verdict", "decided_by", "cause", "decided_ts"],
        "properties": {
          "gate": {"enum": ["quality", "side", "read"]},
          "verdict": {"enum": ["pass", "drop", "review", "personal", "fleet", "as-is", "model"]},
          "decided_by": {"type": "string"},
          "confidence": {"type": ["number", "null"]},
          "cause": {"type": "string"},
          "destination": {"type": ["string", "null"]},
          "note": {"type": ["string", "null"]},
          "lens": {"description": "How a model read takes the item, on a read decision whose verdict is model.", "type": ["string", "null"]},
          "client_id": {"description": "The client that sent a person's decision.", "type": ["string", "null"]},
          "decided_ts": {"type": "string", "format": "date-time"}
        }
      }
    },
    "deliveries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["destination", "outcome", "attempts"],
        "properties": {
          "destination": {"description": "One the destinations file names.", "type": "string"},
          "destination_id": {"description": "The id of the destination's record that holds the item, or that a refusal names.", "type": ["string", "null"]},
          "outcome": {"description": "delivered-to-existing is a record the destination held under no key, which took the item's key. refused is a 409 naming an existing record, kept and never retried. pending waits on its task, which tries again after a failure.", "enum": ["pending", "delivered", "delivered-to-existing", "refused"]},
          "attempts": {"type": "integer"},
          "last_error": {"description": "The destination's answer to the last write that failed, or what a refusal names.", "type": ["string", "null"]}
        }
      }
    },
    "undelivered": {
      "description": "Why an item placed on a side and read as is reaches no deliverer, and null where it does or holds a delivery.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "side", "destination", "message"],
          "properties": {
            "reason": {"description": "no-side-default: the placement named a side and no destination, and no destination in the set in force is that side's default, so the item waits for a set that names one. not-declared: the set in force does not declare the destination placed on. no-deliverer: the destination names no deliverer, as one whose reader pulls its items itself.", "enum": ["no-side-default", "not-declared", "no-deliverer"]},
            "side": {"enum": ["personal", "fleet"]},
            "destination": {"type": ["string", "null"]},
            "message": {"type": "string"}
          }
        },
        {"type": "null"}
      ]
    },
    "suggestion": {"anyOf": [{"$ref": "suggestion.schema.json"}, {"type": "null"}]}
  }
}
